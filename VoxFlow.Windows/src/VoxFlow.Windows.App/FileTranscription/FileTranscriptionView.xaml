<UserControl x:Class="VoxFlow.Windows.App.FileTranscription.FileTranscriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VoxFlow.Windows.App.FileTranscription"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CompactActionButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlainDropButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static local:FileTranscriptionStatusTone.Active}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static local:FileTranscriptionStatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static local:FileTranscriptionStatusTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static local:FileTranscriptionStatusTone.Destructive}">
                    <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="36,34" MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="118" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="≋" FontSize="22" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AccentDarkBrush}" />
                        <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" Margin="0,5,0,0"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <Button x:Name="BrowseFilesButton" Grid.Column="1" Click="OnBrowseFiles"
                        MinWidth="104" Height="34" Style="{StaticResource PrimaryActionButton}"
                        AutomationProperties.Name="{Binding BrowseLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding BrowseLabel}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Button x:Name="DropFilesButton" Grid.Row="2" Style="{StaticResource PlainDropButton}"
                    AllowDrop="True" Drop="OnFilesDropped" Click="OnBrowseFiles"
                    AutomationProperties.Name="{Binding DropTitle}">
                <Grid>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}" />
                    <Rectangle Margin="1" RadiusX="12" RadiusY="12"
                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                               Opacity="0.22" StrokeDashArray="6,4" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⇩" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Opacity="0.72"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding DropTitle}" Margin="0,8,0,0" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SupportedFormats}" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>

            <Border x:Name="MainWorkbench" Grid.Row="4" MinHeight="480" Height="520" MaxHeight="540"
                    Padding="14" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding QueueTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Grid.Row="2" Text="{Binding QueueEmpty}" Margin="18,24"
                                   FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding JobItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="TranscriptionQueue" Grid.Row="2"
                                 ItemsSource="{Binding JobItems}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{Binding QueueTitle}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" CornerRadius="12"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="Transparent" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="14"
                                                           Style="{StaticResource StatusTextStyle}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetadataLine}" Margin="0,2,0,0" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="11" Margin="0,0,5,0"
                                                           Style="{StaticResource StatusTextStyle}" />
                                                <TextBlock Text="{Binding StatusTitle}" FontSize="11" FontWeight="SemiBold"
                                                           Style="{StaticResource StatusTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProcessingSegmentLine}" Margin="0,5,0,0"
                                                       FontSize="11" Foreground="{DynamicResource AccentDarkBrush}"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                            <ProgressBar Height="4" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}" Opacity="0.72" />
                                            <Expander Header="{Binding DataContext.DiagnosticsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Margin="0,7,0,0" FontSize="11"
                                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                                      Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Summary}" Margin="0,0,0,4"
                                                                       TextWrapping="Wrap" FontSize="11"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="{Binding DataContext.StartLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding DataContext.StartLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="OnStart" Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.CancelLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding DataContext.CancelLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="OnCancel" Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.ContinueLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding CanContinue, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding DataContext.ContinueLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="OnContinue" Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.RetryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding DataContext.RetryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="OnRetry" Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.DeleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.Name="{Binding DataContext.DeleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="OnDelete" Style="{StaticResource CompactActionButton}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,4" />

                    <Grid x:Name="ResultPanel" Grid.Column="2" Margin="14,0,0,0">
                        <TextBlock Text="{Binding ResultEmpty}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ContentControl Content="{Binding SelectedItem}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DataContext.ResultTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResultSubtitle}" Margin="0,2,0,0"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Button Content="{Binding DataContext.PlaybackLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding CanPlay}" Click="OnTogglePlayback"
                                                        AutomationProperties.Name="{Binding DataContext.PlaybackLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.HelpText="{Binding DataContext.PlaybackUnavailableHelp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.CopyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding CanUseResult}" Click="OnCopy"
                                                        AutomationProperties.Name="{Binding DataContext.CopyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.HelpText="{Binding DataContext.ResultUnavailableHelp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.ExportLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding CanUseResult}" Click="OnExport"
                                                        AutomationProperties.Name="{Binding DataContext.ExportLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.HelpText="{Binding DataContext.ResultUnavailableHelp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource CompactActionButton}" />
                                                <Button Content="{Binding DataContext.TranslateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding CanTranslate}" Click="OnTranslate"
                                                        AutomationProperties.Name="{Binding DataContext.TranslateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.HelpText="{Binding DataContext.ResultUnavailableHelp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource CompactActionButton}" />
                                                <ProgressBar Width="28" Height="4" Margin="0,12,0,0"
                                                             IsIndeterminate="True"
                                                             AutomationProperties.Name="{Binding DataContext.TranslateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Visibility="{Binding DataContext.IsTranslationInProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                        </Grid>

                                        <Border Grid.Row="2" Padding="14" CornerRadius="12"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="{Binding DataContext.ResultEmpty, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanUseResult}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Grid Visibility="{Binding CanUseResult, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox Text="{Binding FinalText, Mode=OneWay}" Padding="0" IsReadOnly="True"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                             Background="Transparent" FontSize="14"
                                                             AutomationProperties.Name="{Binding DataContext.OriginalLabel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasTranslation}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <Grid Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DataContext.OriginalLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            <TextBox Text="{Binding FinalText, Mode=OneWay}" Margin="0,8,0,0" IsReadOnly="True"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                                     Background="Transparent" FontSize="14"
                                                                     AutomationProperties.Name="{Binding DataContext.OriginalLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="{Binding DataContext.TranslationLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            <TextBox Text="{Binding TranslatedText, Mode=OneWay}" Margin="0,8,0,0" IsReadOnly="True"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                                     Background="Transparent" FontSize="14"
                                                                     AutomationProperties.Name="{Binding DataContext.TranslationLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Expander Grid.Row="3"
                                                  Header="{Binding DataContext.DiagnosticsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Margin="0,8,0,0" FontSize="11"
                                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                                  Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Summary}" Margin="0,0,0,4"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="StatusBar" Grid.Row="6" Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" FontSize="12"
                               AutomationProperties.Name="{Binding Status}"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ProgressBar Grid.Column="2" Height="4" Minimum="0" Maximum="100"
                                 Value="{Binding RunningProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding HasRunningJob, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="4" Text="{Binding JobCountSummary}" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
