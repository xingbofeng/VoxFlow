<UserControl x:Class="VoxFlow.Windows.App.WritingStyles.WritingStylesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PageSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Heading}"
                       FontSize="{DynamicResource HeadingFontSize}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource VoxFlowCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static l10n:L10n.WritingStylesProfilesHeading}"
                               FontSize="{DynamicResource TitleFontSize}"
                               FontWeight="SemiBold" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12"
                                        CornerRadius="{DynamicResource RowCornerRadius}"
                                        Background="{DynamicResource ControlBackgroundBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="&#xE8D2;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}" />
                                        <TextBlock Text="{Binding RoutesSummary}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3"
                            Content="{x:Static l10n:L10n.WritingStylesAddProfile}"
                            Style="{DynamicResource VoxFlowSecondaryButtonStyle}"
                            Click="OnAddProfile" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedProfile}">
                    <Border Style="{DynamicResource VoxFlowCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static l10n:L10n.WritingStylesEditorHeading}"
                                           FontSize="{DynamicResource TitleFontSize}"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1"
                                        Content="{x:Static l10n:L10n.HistoryDelete}"
                                        Style="{DynamicResource VoxFlowQuietButtonStyle}"
                                        IsEnabled="{Binding CanDelete}"
                                        Click="OnDeleteProfile" />
                            </Grid>
                            <TextBlock Text="{x:Static l10n:L10n.WritingStylesNameLabel}"
                                       Margin="0,20,0,7"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsBuiltIn}" />
                            <TextBlock Text="{x:Static l10n:L10n.WritingStylesDescriptionLabel}"
                                       Margin="0,15,0,7"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsBuiltIn}" />
                            <TextBlock Text="{x:Static l10n:L10n.WritingStylesApplicationsLabel}"
                                       Margin="0,15,0,7"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Text="{Binding ApplicationRoutes, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Margin="0,16,0,0"
                                      IsChecked="{Binding AiAutoMatchEnabled}"
                                      Content="{x:Static l10n:L10n.WritingStylesPerStyleAutoMatch}"
                                      Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <CheckBox Margin="0,16,0,0"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsChecked="{Binding AiAutoMatch}"
                              Content="{x:Static l10n:L10n.WritingStylesAutoMatch}"
                              Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}" />

                    <Border Margin="0,16,0,0" Style="{DynamicResource VoxFlowCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l10n:L10n.WritingStylesInstructionLabel}"
                                       FontSize="{DynamicResource TitleFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,12,0,0"
                                     MinHeight="112"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="{x:Static l10n:L10n.WritingStylesMarkdownLabel}"
                                       Margin="0,18,0,7"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding MarkdownTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="100"
                                     AcceptsReturn="True"
                                     FontFamily="Cascadia Mono, Consolas"
                                     TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.WritingStylesPreviewHeading}"
                                       Margin="0,18,0,8"
                                       FontWeight="SemiBold" />
                            <Border Padding="14"
                                    CornerRadius="{DynamicResource RowCornerRadius}"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding PreviewText}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0"
                          DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock Text="{Binding FeedbackMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="{x:Static l10n:L10n.WritingStylesRestore}"
                                    Style="{DynamicResource VoxFlowSecondaryButtonStyle}"
                                    Click="OnRestore" />
                            <Button Content="{x:Static l10n:L10n.WritingStylesSave}"
                                    Margin="10,0,0,0"
                                    Click="OnSave" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
