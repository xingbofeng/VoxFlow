<Window x:Class="VoxFlow.Windows.App.Dialogs.VoxFlowFormDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        SizeToContent="Height"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Border Margin="18"
            Padding="26"
            CornerRadius="20"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding TitleText}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="{Binding PrimaryLabel}"
                           Margin="0,0,0,7"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="PrimaryTextBox"
                         Text="{Binding PrimaryText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="38" />
            </StackPanel>
            <StackPanel x:Name="SecondaryPanel" Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="{Binding SecondaryLabel}"
                           Margin="0,0,0,7"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Text="{Binding SecondaryText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="38"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox x:Name="OptionCheckBox"
                      Grid.Row="3"
                      Margin="0,16,0,0"
                      Content="{Binding OptionLabel}"
                      IsChecked="{Binding OptionValue}" />
            <StackPanel Grid.Row="4"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="{Binding CancelText}"
                        Style="{DynamicResource VoxFlowSecondaryButtonStyle}"
                        MinWidth="92"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button Content="{Binding ConfirmText}"
                        Margin="10,0,0,0"
                        MinWidth="92"
                        IsDefault="True"
                        Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
