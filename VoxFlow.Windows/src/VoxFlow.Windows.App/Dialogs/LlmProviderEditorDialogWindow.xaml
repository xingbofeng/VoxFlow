<Window x:Class="VoxFlow.Windows.App.Dialogs.LlmProviderEditorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
        x:Name="RootWindow"
        Width="680"
        Height="640"
        MinWidth="680"
        MinHeight="640"
        MaxWidth="680"
        MaxHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="EditorFieldStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="EditorComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecondaryActionStyle" TargetType="Button" BasedOn="{StaticResource VoxFlowSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="GetKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxFlowSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <!-- Mac LLMProviderEditorSheet: 680x640 rounded panel -->
    <Border x:Name="SheetBorder"
            Margin="0"
            Padding="0"
            CornerRadius="18"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.22" Direction="270" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title + close (mac sheetHeader height 66) -->
            <Grid x:Name="HeaderRow" Margin="28,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Text="{Binding Editor.Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="12"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCancel"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderCancel}" />
            </Grid>
            <Border Grid.Row="0"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource PanelBorderBrush}" />

            <ScrollViewer x:Name="BodyScroll"
                          Grid.Row="1"
                          MaxHeight="462"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,18">
                <StackPanel x:Name="BodyPanel">
                    <!-- Provider overview card (icon + name + URL + 获取 API 密钥) -->
                    <Border x:Name="OverviewCard"
                            Padding="14"
                            Margin="0,0,0,16"
                            CornerRadius="12"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="14"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE8F1;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="22"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="OverviewTitle"
                                           Text="{Binding Editor.TemplateBadgeLabel}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverviewSubtitle"
                                           Text="{Binding Editor.BaseUrl}"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="GetApiKeyButton"
                                    Grid.Column="2"
                                    Content="{x:Static l10n:L10n.LlmProviderGetApiKey}"
                                    Style="{StaticResource GetKeyButtonStyle}"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Editor.HasApiKeyHelp}"
                                    Click="OnOpenApiKeyHelp"
                                    AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderGetApiKey}" />
                        </Grid>
                    </Border>

                    <!-- Template picker (mac menu-style) -->
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderTemplateLabel}"
                               Style="{StaticResource FieldLabelStyle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <ComboBox x:Name="TemplatePicker"
                              ItemsSource="{Binding TemplateOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding Editor.TemplateId, Mode=OneWay}"
                              Style="{StaticResource EditorComboStyle}"
                              Margin="0,0,0,16"
                              SelectionChanged="OnTemplateSelectionChanged"
                              AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderTemplateLabel}" />

                    <!-- Name -->
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderName}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="DisplayNameBox"
                             Text="{Binding Editor.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorFieldStyle}"
                             Margin="0,0,0,14"
                             AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderName}" />

                    <!-- Service URL -->
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderServiceUrl}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="BaseUrlBox"
                             Text="{Binding Editor.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorFieldStyle}"
                             Margin="0,0,0,14"
                             AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderServiceUrl}" />

                    <!-- API key: password + eye (mac apiKeyField) -->
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderApiKey}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <Grid x:Name="ApiKeyRow" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     MinHeight="40"
                                     Padding="12,9"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     BorderBrush="{DynamicResource PanelBorderBrush}"
                                     BorderThickness="1"
                                     PasswordChanged="OnApiKeyPasswordChanged"
                                     AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderApiKey}">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.IsApiKeyVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        <TextBox x:Name="ApiKeyPlainBox"
                                 MinHeight="40"
                                 Padding="12,9"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 BorderBrush="{DynamicResource PanelBorderBrush}"
                                 BorderThickness="1"
                                 Text="{Binding Editor.DraftApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderApiKey}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.IsApiKeyVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button x:Name="ToggleApiKeyVisibilityButton"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Padding="0"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Content="{Binding Editor.ApiKeyVisibilityGlyph}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnToggleApiKeyVisibility"
                                ToolTip="{Binding Editor.ApiKeyVisibilityTooltip}"
                                AutomationProperties.Name="{Binding Editor.ApiKeyVisibilityTooltip}" />
                    </Grid>
                    <TextBlock x:Name="ApiKeyPresentationText"
                               Text="{Binding Editor.ApiKeyPresentation}"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource CaptionFontSize}" />
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderNoApiKeyRequired}"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="{DynamicResource CaptionFontSize}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.RequiresApiKey}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderCredentialHint}"
                               Margin="0,0,0,16"
                               FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <!-- Model + 刷新 + 添加模型 (mac modelPicker) -->
                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderModel}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <Grid x:Name="ModelRow" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelPicker"
                                  IsEditable="True"
                                  Style="{StaticResource EditorComboStyle}"
                                  ItemsSource="{Binding Editor.ModelOptions}"
                                  Text="{Binding Editor.Model, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderModel}" />
                        <Button x:Name="RefreshModelsButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                MinWidth="72"
                                Content="{x:Static l10n:L10n.LlmProviderRefreshModels}"
                                Style="{StaticResource SecondaryActionStyle}"
                                IsEnabled="{Binding Editor.CanRefreshModels}"
                                Click="OnRefreshModels"
                                AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderRefreshModels}" />
                        <Button x:Name="AddModelButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                MinWidth="88"
                                Content="{x:Static l10n:L10n.LlmProviderAddModel}"
                                Style="{StaticResource SecondaryActionStyle}"
                                Click="OnAddModel"
                                AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderAddModel}" />
                    </Grid>

                    <!-- Temperature + Timeout (Windows extras; compact under model) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static l10n:L10n.LlmProviderTemperature}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TemperatureBox"
                                     Text="{Binding Editor.Temperature, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource EditorFieldStyle}"
                                     AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderTemperature}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">
                                <Run Text="{x:Static l10n:L10n.LlmProviderTimeout}" />
                                <Run Text=" (" />
                                <Run Text="{x:Static l10n:L10n.LlmProviderSeconds}" />
                                <Run Text=")" />
                            </TextBlock>
                            <TextBox x:Name="TimeoutBox"
                                     Text="{Binding Editor.TimeoutSeconds, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource EditorFieldStyle}"
                                     AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderTimeout}" />
                        </StackPanel>
                    </Grid>

                    <!-- Enable toggle row (mac enableRow) -->
                    <Border x:Name="EnableRow"
                            Padding="14,12"
                            CornerRadius="12"
                            Background="{DynamicResource ControlBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l10n:L10n.LlmProviderEnable}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="EnableToggle"
                                      Grid.Column="1"
                                      IsChecked="{Binding Editor.Enabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                                      AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderEnable}" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="FeedbackText"
                               Text="{Binding FeedbackMessage}"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    VerticalAlignment="Top"
                    Height="1"
                    Background="{DynamicResource PanelBorderBrush}" />

            <!-- Footer: 取消 / 保存 (mac actionBar) -->
            <StackPanel x:Name="FooterRow"
                        Grid.Row="2"
                        Margin="28,16,28,18"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="{x:Static l10n:L10n.LlmProviderCancel}"
                        MinWidth="100"
                        MinHeight="38"
                        Style="{DynamicResource VoxFlowSecondaryButtonStyle}"
                        IsCancel="True"
                        Click="OnCancel"
                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderCancel}" />
                <Button x:Name="SaveButton"
                        Content="{x:Static l10n:L10n.LlmProviderSave}"
                        Margin="10,0,0,0"
                        MinWidth="100"
                        MinHeight="38"
                        IsDefault="True"
                        Click="OnSave"
                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderSave}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
