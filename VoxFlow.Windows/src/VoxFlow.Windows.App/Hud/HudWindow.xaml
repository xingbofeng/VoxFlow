<Window x:Class="VoxFlow.Windows.App.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hud="clr-namespace:VoxFlow.Windows.App.Hud"
        Width="520"
        Height="64"
        MinHeight="52"
        MaxHeight="76"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="Height">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border x:Name="Capsule"
            MinHeight="52"
            MaxHeight="76"
            Padding="14,10"
            CornerRadius="12"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5"
            AutomationProperties.Name="{Binding StatusText}"
            AutomationProperties.LiveSetting="Polite">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              ShadowDepth="5"
                              Opacity="0.22"
                              Color="#42000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CapsuleScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="CapsuleTranslate" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Width="42"
                        Height="24"
                        Margin="0,0,12,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowsWaveform, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Rectangle Width="4" Height="8" Margin="2,0" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource AccentBrush}" />
                <Rectangle Width="4" Height="17" Margin="2,0" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource AccentBrush}" />
                <Rectangle Width="4" Height="24" Margin="2,0" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource AccentBrush}" />
                <Rectangle Width="4" Height="14" Margin="2,0" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource AccentBrush}" />
                <Rectangle Width="4" Height="7" Margin="2,0" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource AccentBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding DisplayText}"
                       Visibility="{Binding ShowsText, Converter={StaticResource BooleanToVisibilityConverter}}"
                       MaxHeight="40"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       FontSize="14"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />

            <Border Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="9,4"
                    CornerRadius="8"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static hud:HudPresentationTone.Success}">
                                <Setter Property="Background" Value="#1F0E6B58" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static hud:HudPresentationTone.Failure}">
                                <Setter Property="Background" Value="#22C2413A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </Border>

            <Border Grid.Column="3"
                    Margin="10,0,0,0"
                    Padding="8,4"
                    CornerRadius="8"
                    Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding ShowsCapsLockIndicator, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding CapsLockIndicatorText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentDarkBrush}" />
            </Border>

            <Viewbox Grid.Column="4"
                     Width="18"
                     Height="18"
                     Margin="10,0,0,0"
                     Visibility="{Binding ShowsSpinner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Grid.RenderTransform>
                    <Ellipse Stroke="{DynamicResource PanelBorderBrush}" StrokeThickness="2" />
                    <Path Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="2.4"
                          StrokeStartLineCap="Round"
                          Data="M 9,1 A 8,8 0 0 1 17,9" />
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</Window>
