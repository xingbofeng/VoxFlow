<UserControl x:Class="VoxFlow.Windows.App.Help.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBackgroundBrush}">
    <Grid Margin="{DynamicResource PageSpacing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="15,8" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentDarkBrush}" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding FeatureCards}" Margin="-7,0,-7,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VoxFlowCardStyle}" Margin="7" MinHeight="160">
                                <StackPanel>
                                    <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Heading}" Margin="0,15,0,0" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource VoxFlowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding LinksHeading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding Links}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="OnOpenLink" Padding="16,13" Margin="0,0,0,8"
                                            HorizontalContentAlignment="Stretch"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryTextBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="17"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="{DynamicResource CaptionFontSize}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="Segoe Fluent Icons"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
