<UserControl x:Class="VoxFlow.Windows.App.Settings.TextSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <UserControl.Resources>
        <Style x:Key="ThresholdBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="56" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Heading}"
                   FontSize="{DynamicResource HeadingFontSize}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}"
                   Margin="0,8,0,22"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#EEF0FF"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE8D2;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#6366F1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsTextDeterministicHeading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsTextDeterministicDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Margin="0,0,0,8"
                          IsChecked="{Binding Enabled}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextMaster}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsTextMaster}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsTextMasterDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>

                <StackPanel IsEnabled="{Binding Enabled}">
                    <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                              Margin="0,0,0,8"
                              IsChecked="{Binding SmartNumberRecognition}"
                              AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextSmartNumbers}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l10n:L10n.SettingsTextSmartNumbers}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsTextSmartNumbersDescription}"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource CaptionFontSize}" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                              Margin="0,0,0,8"
                              IsChecked="{Binding PunctuationOptimization}"
                              AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextPunctuation}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l10n:L10n.SettingsTextPunctuation}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsTextPunctuationDescription}"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource CaptionFontSize}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static l10n:L10n.SettingsTextWordPunctuationThreshold}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}" />
                                <TextBox Style="{StaticResource ThresholdBoxStyle}"
                                         Text="{Binding PunctuationWordThreshold, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static l10n:L10n.SettingsTextCjkPunctuationThreshold}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}" />
                                <TextBox Style="{StaticResource ThresholdBoxStyle}"
                                         Text="{Binding PunctuationCjkThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                              Margin="0,0,0,8"
                              IsChecked="{Binding LongSentenceBreaking}"
                              AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextLongSentences}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l10n:L10n.SettingsTextLongSentences}"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static l10n:L10n.SettingsTextWordBreakThreshold}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}" />
                                <TextBox Style="{StaticResource ThresholdBoxStyle}"
                                         Text="{Binding LongSentenceWordThreshold, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,12,0" />
                                <TextBlock Text="{x:Static l10n:L10n.SettingsTextCjkBreakThreshold}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}" />
                                <TextBox Style="{StaticResource ThresholdBoxStyle}"
                                         Text="{Binding LongSentenceCjkThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                              Margin="0,0,0,8"
                              Content="{x:Static l10n:L10n.SettingsTextFillerWords}"
                              IsChecked="{Binding FillerWordFiltering}"
                              AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextFillerWords}" />

                    <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                              Margin="0,0,0,8"
                              Content="{x:Static l10n:L10n.SettingsTextCjkSpacing}"
                              IsChecked="{Binding CjkLatinSpacing}"
                              AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextCjkSpacing}" />

                    <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                              Content="{x:Static l10n:L10n.SettingsTextCapitalization}"
                              IsChecked="{Binding AutoCapitalization}"
                              AutomationProperties.Name="{x:Static l10n:L10n.SettingsTextCapitalization}" />
                </StackPanel>

                <TextBlock Text="{Binding FeedbackMessage}"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Content="{x:Static l10n:L10n.SettingsActionApply}"
                        Style="{DynamicResource VoxFlowButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        IsEnabled="{Binding CanSave}"
                        Click="OnSave" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
