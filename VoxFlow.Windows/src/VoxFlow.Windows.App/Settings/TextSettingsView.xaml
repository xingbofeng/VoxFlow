<UserControl x:Class="VoxFlow.Windows.App.Settings.TextSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,22" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <settings:OpenAiSettingsCardView DataContext="{Binding OpenAi}" Margin="0,0,0,18" />
        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <CheckBox Content="{x:Static l10n:L10n.SettingsTextMaster}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" Margin="0,0,0,16" />
                <UniformGrid Columns="2">
                    <CheckBox Content="{x:Static l10n:L10n.SettingsTextSmartNumbers}" IsChecked="{Binding SmartNumberRecognition}" Margin="0,0,16,10" />
                    <CheckBox Content="{x:Static l10n:L10n.SettingsTextPunctuation}" IsChecked="{Binding PunctuationOptimization}" Margin="0,0,0,10" />
                    <CheckBox Content="{x:Static l10n:L10n.SettingsTextLongSentences}" IsChecked="{Binding LongSentenceBreaking}" Margin="0,0,16,10" />
                    <CheckBox Content="{x:Static l10n:L10n.SettingsTextFillerWords}" IsChecked="{Binding FillerWordFiltering}" Margin="0,0,0,10" />
                    <CheckBox Content="{x:Static l10n:L10n.SettingsTextCjkSpacing}" IsChecked="{Binding CjkLatinSpacing}" Margin="0,0,16,10" />
                    <CheckBox Content="{x:Static l10n:L10n.SettingsTextCapitalization}" IsChecked="{Binding AutoCapitalization}" Margin="0,0,0,10" />
                </UniformGrid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Static l10n:L10n.SettingsTextWordBreakThreshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Column="1" Text="{Binding LongSentenceWordThreshold, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="3" Text="{x:Static l10n:L10n.SettingsTextCjkBreakThreshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Column="4" Text="{Binding LongSentenceCjkThreshold, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Text="{x:Static l10n:L10n.SettingsTextCjkPunctuationThreshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PunctuationCjkThreshold, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Static l10n:L10n.SettingsTextWordPunctuationThreshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding PunctuationWordThreshold, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Button Content="{x:Static l10n:L10n.SettingsActionApply}" Style="{DynamicResource VoxFlowButtonStyle}" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnSave" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
