<UserControl x:Class="VoxFlow.Windows.App.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Heading}"
                   FontSize="{DynamicResource HeadingFontSize}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}"
                   Margin="0,8,0,22"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <!-- Basics: language / theme / launch / tray / capslock (mac order) -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#FDECEC"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#E35D5D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralBasicsHeading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralBasicsDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Border Padding="14,12"
                        Margin="0,0,0,8"
                        CornerRadius="{DynamicResource RowCornerRadius}"
                        Background="{DynamicResource ControlBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralUiLanguage}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralUiLanguageDescription}"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource CaptionFontSize}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding UiLanguageChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding UiLanguageId, Mode=TwoWay}"
                                  IsEnabled="{Binding CanManageGeneralSettings}"
                                  AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralUiLanguage}" />
                    </Grid>
                </Border>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Margin="0,0,0,8"
                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                          IsEnabled="{Binding CanManageGeneralSettings}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralDarkTheme}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralDarkTheme}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralDarkThemeDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Margin="0,0,0,8"
                          IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                          IsEnabled="{Binding CanManageGeneralSettings}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralLaunchAtLogin}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralLaunchAtLogin}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralLaunchAtLoginDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Margin="0,0,0,8"
                          IsChecked="{Binding GrayTrayIcon, Mode=TwoWay}"
                          IsEnabled="{Binding CanManageGeneralSettings}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralGrayTrayIcon}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralGrayTrayIcon}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralGrayTrayIconDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          IsChecked="{Binding CapsLockIndicator, Mode=TwoWay}"
                          IsEnabled="{Binding CanManageGeneralSettings}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralCapsLockIndicator}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralCapsLockIndicator}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralCapsLockIndicatorDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Local models -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#FFF6E5"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE964;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#E09B2D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralLocalModelsHeading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralLocalModelsDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Margin="0,0,0,8"
                          IsChecked="{Binding StreamPreview, Mode=TwoWay}"
                          IsEnabled="{Binding CanManageGeneralSettings}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralStreamPreview}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralStreamPreview}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralStreamPreviewDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          IsChecked="{Binding AutoReleaseModels, Mode=TwoWay}"
                          IsEnabled="{Binding CanManageGeneralSettings}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsGeneralAutoReleaseModels}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralAutoReleaseModels}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralAutoReleaseModelsDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Permissions -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#EEF5FF"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#4C7DFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralPermissions}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralPermissionsDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Button Content="{x:Static l10n:L10n.SettingsGeneralOpenMicrophonePrivacy}"
                        HorizontalAlignment="Left"
                        Click="OnOpenMicrophonePrivacy" />
            </StackPanel>
        </Border>

        <!-- Data & diagnostics -->
        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#F4F1FF"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#7B61FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralData}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralDataDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static l10n:L10n.SettingsGeneralCopyDiagnostics}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanExecuteActions}"
                            Click="OnCopyDiagnostics" />
                    <Button Content="{x:Static l10n:L10n.SettingsGeneralReset}"
                            IsEnabled="{Binding CanExecuteActions}"
                            Click="OnResetSettings" />
                </StackPanel>
                <TextBlock Text="{Binding FeedbackMessage}"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource VoxFlowCardStyle}"
                Margin="0,18,0,0"
                Visibility="{Binding ShowsDebugTools, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DataContext="{Binding DebugTranscript}">
                <TextBlock Text="{Binding Heading}"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,6,0,12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Modes}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedModeId, Mode=TwoWay}"
                          Margin="0,0,0,10" />
                <TextBox Text="{Binding Transcript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="96"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{Binding Placeholder}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{Binding RunLabel}"
                            IsEnabled="{Binding CanRun}"
                            Click="OnRunDebugTranscript" />
                    <TextBlock Text="{Binding FeedbackMessage}"
                               Margin="12,4,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
