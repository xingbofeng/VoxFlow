<UserControl x:Class="VoxFlow.Windows.App.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,22" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralAppearance}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <CheckBox Content="{x:Static l10n:L10n.SettingsGeneralDarkTheme}" Margin="0,16,0,10" />
                <CheckBox Content="{x:Static l10n:L10n.SettingsGeneralLaunchAtLogin}" />
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralPermissions}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <Button Content="{x:Static l10n:L10n.SettingsGeneralOpenMicrophonePrivacy}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="OnOpenMicrophonePrivacy" />
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static l10n:L10n.SettingsGeneralData}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="{x:Static l10n:L10n.SettingsGeneralCopyDiagnostics}" Margin="0,0,10,0" />
                    <Button Content="{x:Static l10n:L10n.SettingsGeneralReset}" Click="OnResetSettings" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
