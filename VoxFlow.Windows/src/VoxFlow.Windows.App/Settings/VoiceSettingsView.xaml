<UserControl x:Class="VoxFlow.Windows.App.Settings.VoiceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,22" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />

        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding Cards[0].Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[0].Description}" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceDevice}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableDevices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceLanguage}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding RecognitionLanguages}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding RecognitionLanguageId, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding Cards[1].Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[1].Description}" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ShortcutDisplay}" Margin="0,0,0,6" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceInteraction}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding InteractionModes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding InteractionModeId, Mode=TwoWay}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="{x:Static l10n:L10n.SettingsVoiceMiddleMouse}" IsChecked="{Binding MiddleMouseEnabled}" VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding Cards[2].Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[2].Description}" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <CheckBox Content="{x:Static l10n:L10n.SettingsVoiceMutePlayback}" IsChecked="{Binding MutePlaybackDuringRecording}" Margin="0,0,0,10" />
                <CheckBox Content="{x:Static l10n:L10n.SettingsVoiceFeedbackSounds}" IsChecked="{Binding FeedbackSoundsEnabled}" Margin="0,0,0,10" />
                <CheckBox Content="{x:Static l10n:L10n.SettingsVoiceEnhancement}" IsChecked="{Binding VoiceEnhancementEnabled}" />
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding Cards[3].Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[3].Description}" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <RadioButton Height="76" IsChecked="{Binding IsQuickPaste}" GroupName="OutputMode" VerticalContentAlignment="Center">
                        <StackPanel Margin="10,0"><TextBlock Text="{x:Static l10n:L10n.SettingsVoiceQuickPaste}" FontWeight="SemiBold" /><TextBlock Text="{x:Static l10n:L10n.SettingsVoiceQuickPasteDescription}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" Height="76" IsChecked="{Binding IsSimulatedTyping}" GroupName="OutputMode" VerticalContentAlignment="Center">
                        <StackPanel Margin="10,0"><TextBlock Text="{x:Static l10n:L10n.SettingsVoiceSimulatedTyping}" FontWeight="SemiBold" /><TextBlock Text="{x:Static l10n:L10n.SettingsVoiceSimulatedTypingDescription}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                    </RadioButton>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Cards[4].Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[4].Description}" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <CheckBox Content="{x:Static l10n:L10n.SettingsVoiceKeepMicrophoneActive}" IsChecked="{Binding KeepMicrophoneActive}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
