<UserControl x:Class="VoxFlow.Windows.App.Settings.VoiceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Heading}"
                   FontSize="{DynamicResource HeadingFontSize}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}"
                   Margin="0,8,0,22"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <!-- Input and language -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#FFF3E5"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE720;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#E09B2D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Cards[0].Heading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Cards[0].Description}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Border Padding="14,12"
                        Margin="0,0,0,8"
                        CornerRadius="{DynamicResource RowCornerRadius}"
                        Background="{DynamicResource ControlBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceDevice}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding AvailableDevices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static l10n:L10n.SettingsVoiceDevice}" />
                    </Grid>
                </Border>

                <Border Padding="14,12"
                        CornerRadius="{DynamicResource RowCornerRadius}"
                        Background="{DynamicResource ControlBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceLanguage}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding RecognitionLanguages}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding RecognitionLanguageId, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static l10n:L10n.SettingsVoiceLanguage}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Voice shortcuts -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#F3E8FF"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE765;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#8B5CF6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Cards[1].Heading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Cards[1].Description}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <settings:InteractiveHotkeyRowView DataContext="{Binding DictationHotkey}" />

                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Margin="0,0,0,12"
                          IsChecked="{Binding MiddleMouseEnabled}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsVoiceMiddleMouse}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceMiddleMouse}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceMiddleMouseDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceTriggerMode}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border CornerRadius="10"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{x:Static l10n:L10n.SettingsVoiceModeHold}"
                                         GroupName="VoiceTriggerMode"
                                         IsChecked="{Binding IsHoldMode, Mode=TwoWay}"
                                         Padding="14,7"
                                         Margin="0,0,4,0"
                                         VerticalContentAlignment="Center" />
                            <RadioButton Content="{x:Static l10n:L10n.SettingsVoiceModeToggle}"
                                         GroupName="VoiceTriggerMode"
                                         IsChecked="{Binding IsToggleMode, Mode=TwoWay}"
                                         Padding="14,7"
                                         VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceTriggerModeHint}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource CaptionFontSize}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource VoxFlowCardStyle}"
                Margin="0,0,0,18"
                Visibility="{Binding HasAgentHotkey, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{x:Static l10n:L10n.SettingsHotkeyAgentSectionTitle}"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static l10n:L10n.SettingsHotkeyAgentSectionDescription}"
                           Margin="0,6,0,14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <settings:InteractiveHotkeyRowView DataContext="{Binding AgentHotkey}" />
            </StackPanel>
        </Border>

        <!-- Audio -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#E8F4FF"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE767;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#3B82F6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Cards[2].Heading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Cards[2].Description}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Content="{x:Static l10n:L10n.SettingsVoiceMutePlayback}"
                          IsChecked="{Binding MutePlaybackDuringRecording}"
                          Margin="0,0,0,8" />
                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Content="{x:Static l10n:L10n.SettingsVoiceFeedbackSounds}"
                          IsChecked="{Binding FeedbackSoundsEnabled}"
                          Margin="0,0,0,8" />
                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Content="{x:Static l10n:L10n.SettingsVoiceEnhancement}"
                          IsChecked="{Binding VoiceEnhancementEnabled}" />
            </StackPanel>
        </Border>

        <!-- Output -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding Cards[3].Heading}"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[3].Description}"
                           Margin="0,6,0,14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Height="76"
                                 IsChecked="{Binding IsQuickPaste}"
                                 GroupName="OutputMode"
                                 VerticalContentAlignment="Center">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceQuickPaste}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceQuickPasteDescription}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2"
                                 Height="76"
                                 IsChecked="{Binding IsSimulatedTyping}"
                                 GroupName="OutputMode"
                                 VerticalContentAlignment="Center">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceSimulatedTyping}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsVoiceSimulatedTypingDescription}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Runtime -->
        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Cards[4].Heading}"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Cards[4].Description}"
                           Margin="0,6,0,14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          Content="{x:Static l10n:L10n.SettingsVoiceKeepMicrophoneActive}"
                          IsChecked="{Binding KeepMicrophoneActive}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
