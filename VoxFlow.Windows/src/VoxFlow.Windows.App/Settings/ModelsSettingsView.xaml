<UserControl x:Class="VoxFlow.Windows.App.Settings.ModelsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,18" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Tabs[0].Label}">
                <StackPanel Margin="0,18,0,0">
                <ItemsControl ItemsSource="{Binding AsrCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Margin="0,6,20,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource ControlBackgroundBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Status}" FontSize="{DynamicResource CaptionFontSize}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,12" DataContext="{Binding Tencent}">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCloudAudioNotice}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource CaptionFontSize}" />
                            <UniformGrid Columns="3" Margin="0,12,0,10">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="{x:Static l10n:L10n.SettingsCredentialAppId}" /><PasswordBox x:Name="TencentAppId" /></StackPanel>
                                <StackPanel Margin="4,0"><TextBlock Text="{x:Static l10n:L10n.SettingsCredentialSecretId}" /><PasswordBox x:Name="TencentSecretId" /></StackPanel>
                                <StackPanel Margin="8,0,0,0"><TextBlock Text="{x:Static l10n:L10n.SettingsCredentialSecretKey}" /><PasswordBox x:Name="TencentSecretKey" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l10n:L10n.SettingsActionSave}" Margin="0,0,8,0" Click="OnSaveTencent" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionTest}" Margin="0,0,8,0" Click="OnTestTencent" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}" Click="OnDeleteTencent" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,12" DataContext="{Binding Aliyun}">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCloudAudioNotice}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource CaptionFontSize}" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialApiKey}" Margin="0,12,0,0" />
                            <PasswordBox x:Name="AliyunApiKey" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l10n:L10n.SettingsActionSave}" Margin="0,0,8,0" Click="OnSaveAliyun" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionTest}" Margin="0,0,8,0" Click="OnTestAliyun" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}" Click="OnDeleteAliyun" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource VoxFlowCardStyle}" DataContext="{Binding Volcengine}">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCloudAudioNotice}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource CaptionFontSize}" />
                            <UniformGrid Columns="3" Margin="0,12,0,10">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="{x:Static l10n:L10n.SettingsCredentialAppId}" /><PasswordBox x:Name="VolcengineAppId" /></StackPanel>
                                <StackPanel Margin="4,0"><TextBlock Text="{x:Static l10n:L10n.SettingsCredentialAccessToken}" /><PasswordBox x:Name="VolcengineAccessToken" /></StackPanel>
                                <StackPanel Margin="8,0,0,0"><TextBlock Text="{x:Static l10n:L10n.SettingsCredentialSecretKey}" /><PasswordBox x:Name="VolcengineSecretKey" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l10n:L10n.SettingsActionSave}" Margin="0,0,8,0" Click="OnSaveVolcengine" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionTest}" Margin="0,0,8,0" Click="OnTestVolcengine" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}" Click="OnDeleteVolcengine" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Tabs[1].Label}">
                <settings:OpenAiSettingsCardView DataContext="{Binding OpenAi}" Margin="0,18,0,0" />
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
