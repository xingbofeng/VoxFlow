<UserControl x:Class="VoxFlow.Windows.App.Settings.ModelsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,18" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="{Binding Heading}">
            <TabItem Header="{Binding Tabs[0].Label}" AutomationProperties.Name="{Binding Tabs[0].Label}">
                <StackPanel Margin="0,18,0,0"
                            TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
                <ItemsControl ItemsSource="{Binding QwenCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Margin="0,6,20,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="5"
                                                     Margin="0,12,20,0"
                                                     Visibility="{Binding ShowsProgress, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding FeedbackMessage}"
                                                   Margin="0,10,20,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" MinWidth="126" HorizontalAlignment="Right">
                                        <Border Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource AccentDarkBrush}" />
                                        </Border>
                                        <Button Content="{Binding PrimaryActionLabel}"
                                                Margin="0,10,0,0"
                                                IsEnabled="{Binding CanExecutePrimary}"
                                                Click="OnQwenPrimary"
                                                AutomationProperties.Name="{Binding PrimaryActionLabel}" />
                                        <Button Content="{x:Static l10n:L10n.SettingsActionDelete}"
                                                Margin="0,6,0,0"
                                                IsEnabled="{Binding CanDelete}"
                                                Click="OnQwenDelete"
                                                AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionDelete}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <Expander Style="{StaticResource VoxFlowProviderExpanderStyle}"
                              DataContext="{Binding Tencent}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Foreground="{DynamicResource AccentDarkBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentDarkBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCloudAudioNotice}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource CaptionFontSize}" />
                            <UniformGrid Columns="3" Margin="0,12,0,10">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialAppId}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TencentAppId" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialAppId}" TabIndex="1" />
                                        <TextBox x:Name="TencentAppIdVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialAppId}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="34" Padding="6,4"
                                                Content="{Binding RevealGlyph}" FontSize="14"
                                                Click="OnToggleTencentSecrets"
                                                IsEnabled="{Binding CanRevealSecrets}"
                                                ToolTip="{Binding RevealActionLabel}"
                                                AutomationProperties.Name="{Binding RevealActionLabel}" TabIndex="2" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialSecretId}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TencentSecretId" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialSecretId}" TabIndex="2" />
                                        <TextBox x:Name="TencentSecretIdVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialSecretId}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="34" Padding="6,4"
                                                Content="{Binding RevealGlyph}" FontSize="14"
                                                Click="OnToggleTencentSecrets"
                                                IsEnabled="{Binding CanRevealSecrets}"
                                                ToolTip="{Binding RevealActionLabel}"
                                                AutomationProperties.Name="{Binding RevealActionLabel}" TabIndex="4" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialSecretKey}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TencentSecretKey" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialSecretKey}" TabIndex="3" />
                                        <TextBox x:Name="TencentSecretKeyVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialSecretKey}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="36" Padding="6,4"
                                                Content="{Binding RevealGlyph}"
                                                FontSize="14"
                                                Click="OnToggleTencentSecrets"
                                                IsEnabled="{Binding CanRevealSecrets}"
                                                ToolTip="{Binding RevealActionLabel}"
                                                AutomationProperties.Name="{Binding RevealActionLabel}"
                                                TabIndex="4" />
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l10n:L10n.SettingsActionSave}" Margin="0,0,8,0" Click="OnSaveTencent" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionSave}" TabIndex="5" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionTest}" Margin="0,0,8,0" Click="OnTestTencent" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionTest}" TabIndex="6" />
                                <Button Content="{Binding SelectActionLabel}" Margin="0,0,8,0" Click="OnSelectTencent" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding SelectActionLabel}" TabIndex="7" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}" Click="OnDeleteTencent" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionDelete}" TabIndex="8" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource VoxFlowProviderExpanderStyle}"
                              DataContext="{Binding Aliyun}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Foreground="{DynamicResource AccentDarkBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentDarkBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCloudAudioNotice}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource CaptionFontSize}" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialApiKey}" Margin="0,12,0,0" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AliyunApiKey" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialApiKey}" TabIndex="9" />
                                <TextBox x:Name="AliyunApiKeyVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialApiKey}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="36" Padding="6,4"
                                        Content="{Binding RevealGlyph}"
                                        FontSize="14"
                                        Click="OnToggleAliyunSecrets"
                                        IsEnabled="{Binding CanRevealSecrets}"
                                        ToolTip="{Binding RevealActionLabel}"
                                        AutomationProperties.Name="{Binding RevealActionLabel}"
                                        TabIndex="10" />
                            </Grid>
                            <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l10n:L10n.SettingsActionSave}" Margin="0,0,8,0" Click="OnSaveAliyun" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionSave}" TabIndex="11" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionTest}" Margin="0,0,8,0" Click="OnTestAliyun" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionTest}" TabIndex="12" />
                                <Button Content="{Binding SelectActionLabel}" Margin="0,0,8,0" Click="OnSelectAliyun" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding SelectActionLabel}" TabIndex="13" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}" Click="OnDeleteAliyun" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionDelete}" TabIndex="14" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Style="{StaticResource VoxFlowProviderExpanderStyle}"
                              DataContext="{Binding Volcengine}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Foreground="{DynamicResource AccentDarkBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentDarkBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,4" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Static l10n:L10n.SettingsCloudAudioNotice}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource CaptionFontSize}" />
                            <UniformGrid Columns="3" Margin="0,12,0,10">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialAppId}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="VolcengineAppId" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialAppId}" TabIndex="15" />
                                        <TextBox x:Name="VolcengineAppIdVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialAppId}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="34" Padding="6,4"
                                                Content="{Binding RevealGlyph}" FontSize="14"
                                                Click="OnToggleVolcengineSecrets"
                                                IsEnabled="{Binding CanRevealSecrets}"
                                                ToolTip="{Binding RevealActionLabel}"
                                                AutomationProperties.Name="{Binding RevealActionLabel}" TabIndex="18" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialAccessToken}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="VolcengineAccessToken" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialAccessToken}" TabIndex="16" />
                                        <TextBox x:Name="VolcengineAccessTokenVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialAccessToken}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="34" Padding="6,4"
                                                Content="{Binding RevealGlyph}" FontSize="14"
                                                Click="OnToggleVolcengineSecrets"
                                                IsEnabled="{Binding CanRevealSecrets}"
                                                ToolTip="{Binding RevealActionLabel}"
                                                AutomationProperties.Name="{Binding RevealActionLabel}" TabIndex="20" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{x:Static l10n:L10n.SettingsCredentialSecretKey}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="VolcengineSecretKey" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialSecretKey}" TabIndex="17" />
                                        <TextBox x:Name="VolcengineSecretKeyVisible" Visibility="Collapsed" AutomationProperties.Name="{x:Static l10n:L10n.SettingsCredentialSecretKey}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="36" Padding="6,4"
                                                Content="{Binding RevealGlyph}"
                                                FontSize="14"
                                                Click="OnToggleVolcengineSecrets"
                                                IsEnabled="{Binding CanRevealSecrets}"
                                                ToolTip="{Binding RevealActionLabel}"
                                                AutomationProperties.Name="{Binding RevealActionLabel}"
                                                TabIndex="18" />
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l10n:L10n.SettingsActionSave}" Margin="0,0,8,0" Click="OnSaveVolcengine" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionSave}" TabIndex="19" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionTest}" Margin="0,0,8,0" Click="OnTestVolcengine" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionTest}" TabIndex="20" />
                                <Button Content="{Binding SelectActionLabel}" Margin="0,0,8,0" Click="OnSelectVolcengine" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding SelectActionLabel}" TabIndex="21" />
                                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}" Click="OnDeleteVolcengine" IsEnabled="{Binding CanExecuteActions}" AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionDelete}" TabIndex="22" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Tabs[1].Label}" AutomationProperties.Name="{Binding Tabs[1].Label}">
                <Grid Margin="0,18,0,0"
                      TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
                    <settings:OpenAiSettingsCardView DataContext="{Binding OpenAi}"
                                                     Visibility="{Binding DataContext.UsesLegacyOpenAiCard, RelativeSource={RelativeSource AncestorType={x:Type settings:ModelsSettingsView}}, Converter={StaticResource BoolToVisibility}}" />
                    <settings:LlmProviderSettingsView DataContext="{Binding LlmProviders}"
                                                      Visibility="{Binding DataContext.HasLlmProviderManagement, RelativeSource={RelativeSource AncestorType={x:Type settings:ModelsSettingsView}}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Tabs[2].Label}" AutomationProperties.Name="{Binding Tabs[2].Label}">
                <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,18,0,0" DataContext="{Binding BuiltinAgent}"
                        TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
                        AutomationProperties.Name="{Binding Heading}" AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="✦" FontFamily="{DynamicResource AppFontFamily}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AccentDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,14" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding RuntimeLabel}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding RuntimeStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{Binding VersionLabel}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Text="{Binding HashLabel}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hash}" Margin="0,8,0,0" FontFamily="Cascadia Mono" FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="{Binding ProviderLabel}" Margin="0,14,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Provider}" Margin="0,14,0,0" />
                                <TextBlock Grid.Row="4" Text="{Binding ModelLabel}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Model}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="{Binding ConnectionHealthLabel}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ConnectionHealth}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="6" Text="{Binding ToolCallingHealthLabel}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ToolCallingHealth}" Margin="0,8,0,0" />
                            </Grid>
                            <Button Content="{x:Static l10n:L10n.SettingsActionTest}"
                                    Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Click="OnTestBuiltinAgent" IsEnabled="{Binding CanTest}"
                                    AutomationProperties.Name="{x:Static l10n:L10n.SettingsActionTest}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
