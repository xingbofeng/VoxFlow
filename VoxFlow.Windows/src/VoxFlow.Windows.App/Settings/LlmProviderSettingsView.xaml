<UserControl x:Class="VoxFlow.Windows.App.Settings.LlmProviderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ProviderActionButton"
               TargetType="Button"
               BasedOn="{StaticResource VoxFlowSecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ProviderDangerButton"
               TargetType="Button"
               BasedOn="{StaticResource ProviderActionButton}">
            <Setter Property="Foreground" Value="#C0392B" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: title + 添加服务商 (mac LLM tab) -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static l10n:L10n.LlmProviderTitle}"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static l10n:L10n.LlmProviderSubtitle}"
                           Margin="0,5,18,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="AddProviderButton"
                    Grid.Column="1"
                    Content="{x:Static l10n:L10n.LlmProviderAdd}"
                    VerticalAlignment="Top"
                    MinWidth="110"
                    MinHeight="36"
                    Click="OnAddProvider"
                    AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderAdd}"
                    TabIndex="0" />
        </Grid>

        <!-- Empty state -->
        <Border x:Name="EmptyState"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource VoxFlowCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Providers.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{x:Static l10n:L10n.LlmProviderEmpty}"
                       MinHeight="96"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>

        <!-- Provider cards (mac list: icon · meta · enable/default · actions) -->
        <ItemsControl x:Name="ProviderList" ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,12" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Logo badge -->
                                <Border Width="48" Height="48" CornerRadius="14"
                                        Background="{DynamicResource ControlBackgroundBrush}">
                                    <TextBlock Text="{x:Static l10n:L10n.LlmProviderBadge}"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>

                                <!-- Meta -->
                                <StackPanel Grid.Column="1" Margin="14,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{DynamicResource TitleFontSize}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="8"
                                                Background="{DynamicResource ControlBackgroundBrush}">
                                            <TextBlock Text="{Binding EnabledStatusText}"
                                                       FontSize="{DynamicResource CaptionFontSize}" />
                                        </Border>
                                        <Border Margin="6,0,0,0" Padding="8,3" CornerRadius="8"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{x:Static l10n:L10n.LlmProviderCurrent}"
                                                       FontSize="{DynamicResource CaptionFontSize}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BaseUrl}" Margin="0,7,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Model}" Margin="0,3,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Static l10n:L10n.LlmProviderApiKey}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding ApiKeyPresentation}"
                                                   Margin="6,0,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding DisplayedHealthStatusText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HealthLatencyMs, StringFormat={}{0} ms}"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding DisplayedAgentCapabilityStatusText}"
                                                   Margin="16,0,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActionFeedbackMessage}"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar Height="3"
                                                 Margin="0,7,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Right: enable switch + 设为默认 (mac) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="120">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static l10n:L10n.LlmProviderEnable}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanRunActions}"
                                                  Tag="{Binding Id}"
                                                  Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                                                  Click="OnToggleProvider"
                                                  AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderEnable}" />
                                    </Grid>
                                    <Button Content="{x:Static l10n:L10n.LlmProviderSetDefault}"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource ProviderActionButton}"
                                            Tag="{Binding Id}"
                                            IsEnabled="{Binding CanSetDefault}"
                                            Click="OnSetDefault"
                                            AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderSetDefault}" />
                                </StackPanel>
                            </Grid>

                            <!-- Action row: 测试连接 · 测试 Agent · 编辑 · 删除 -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="62,14,0,0">
                                <Button Content="{x:Static l10n:L10n.LlmProviderTestConnection}"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource ProviderActionButton}"
                                        IsEnabled="{Binding CanRunActions}"
                                        Click="OnTestConnection"
                                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderTestConnection}" />
                                <Button Content="{x:Static l10n:L10n.LlmProviderTestAgent}"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource ProviderActionButton}"
                                        IsEnabled="{Binding CanRunActions}"
                                        Click="OnTestAgent"
                                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderTestAgent}" />
                                <Button Content="{x:Static l10n:L10n.LlmProviderEdit}"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource ProviderActionButton}"
                                        IsEnabled="{Binding CanRunActions}"
                                        Click="OnEditProvider"
                                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderEdit}" />
                                <Button Content="{x:Static l10n:L10n.LlmProviderDelete}"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource ProviderDangerButton}"
                                        IsEnabled="{Binding CanRunActions}"
                                        Click="OnDeleteProvider"
                                        AutomationProperties.Name="{x:Static l10n:L10n.LlmProviderDelete}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding FeedbackMessage}"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
