<UserControl x:Class="VoxFlow.Windows.App.Settings.ScreenshotSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings">
    <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Heading}"
                   FontSize="{DynamicResource HeadingFontSize}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitle}"
                   Margin="0,8,0,22"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <!-- Hotkeys card: clipboard OCR first, then screenshot OCR (mac order) -->
        <Border Style="{DynamicResource VoxFlowCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#E8F7F0"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsScreenshotHotkeyHeading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsScreenshotHotkeyDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <settings:InteractiveHotkeyRowView DataContext="{Binding ClipboardImageOcrHotkey}" />
                <Separator Margin="0,4,0,14"
                           Background="{DynamicResource PanelBorderBrush}" />
                <settings:InteractiveHotkeyRowView DataContext="{Binding ScreenshotHotkey}" />
            </StackPanel>
        </Border>

        <!-- Write-mode card with labeled switch row -->
        <Border Style="{DynamicResource VoxFlowCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="#EAF0FF"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE70F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#4C7DFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l10n:L10n.SettingsScreenshotClipboardHeading}"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsScreenshotClipboardDescription}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{DynamicResource VoxFlowSwitchCheckBoxStyle}"
                          IsChecked="{Binding ClipboardOcrEnabled}"
                          AutomationProperties.Name="{x:Static l10n:L10n.SettingsScreenshotClipboardToggle}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l10n:L10n.SettingsScreenshotClipboardToggle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static l10n:L10n.SettingsScreenshotClipboardToggleDescription}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource CaptionFontSize}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
