<UserControl x:Class="VoxFlow.Windows.App.Settings.OpenAiSettingsCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization">
    <Border Style="{DynamicResource VoxFlowCardStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" Margin="0,6,0,16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Static l10n:L10n.SettingsOpenAiBaseUrl}" VerticalAlignment="Center" />
                <TextBox x:Name="BaseUrlBox" Grid.Column="1" Text="{Binding BaseUrl, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Text="{x:Static l10n:L10n.SettingsOpenAiModel}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Text="{x:Static l10n:L10n.SettingsOpenAiApiKey}" VerticalAlignment="Center" />
                <PasswordBox x:Name="ApiKeyBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="{x:Static l10n:L10n.SettingsOpenAiApiKey}" />
            </Grid>
            <CheckBox Content="{x:Static l10n:L10n.SettingsOpenAiEnabled}" IsChecked="{Binding Enabled}" Margin="0,14,0,14" />
            <TextBlock Text="{Binding ApiKeyPresentation}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding FeedbackMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static l10n:L10n.SettingsActionSave}"
                        Margin="0,0,10,0"
                        MinWidth="92"
                        IsEnabled="{Binding CanExecuteActions}"
                        Click="OnSave" />
                <Button Content="{x:Static l10n:L10n.SettingsActionTest}"
                        Margin="0,0,10,0"
                        MinWidth="110"
                        IsEnabled="{Binding CanExecuteActions}"
                        Click="OnTest" />
                <Button Content="{x:Static l10n:L10n.SettingsActionDelete}"
                        MinWidth="92"
                        IsEnabled="{Binding CanExecuteActions}"
                        Click="OnDelete" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
