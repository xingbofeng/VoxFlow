<Window x:Class="VoxFlow.Windows.App.Screenshot.ScreenshotToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="716" Height="44"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="True" SizeToContent="Manual">
    <Window.Resources>
        <Style x:Key="ScreenshotTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#C7000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="VerticalOffset" Value="-6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                             Value="True">
                    <Setter Property="Background" Value="{x:Static SystemColors.WindowBrush}" />
                    <Setter Property="Foreground" Value="{x:Static SystemColors.WindowTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScreenshotToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#0A000000" />
            <Setter Property="Foreground" Value="{DynamicResource ScreenshotToolbarForegroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource ScreenshotAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource ScreenshotAccentBrush}" />
                                <Setter TargetName="Background" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ScreenshotAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ScreenshotAccentDarkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ScreenshotAccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                             Value="True">
                    <Setter Property="Background" Value="{x:Static SystemColors.WindowBrush}" />
                    <Setter Property="Foreground" Value="{x:Static SystemColors.WindowTextBrush}" />
                    <Setter Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScreenshotPopoverOptionButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#0A000000" />
            <Setter Property="Foreground" Value="{DynamicResource ScreenshotToolbarForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OptionBackground" Property="Background" Value="{DynamicResource ScreenshotAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBackground" Property="BorderBrush" Value="{DynamicResource ScreenshotAccentBrush}" />
                                <Setter TargetName="OptionBackground" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesSelectionBackground}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ScreenshotAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ScreenshotAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                             Value="True">
                    <Setter Property="Background" Value="{x:Static SystemColors.WindowBrush}" />
                    <Setter Property="Foreground" Value="{x:Static SystemColors.WindowTextBrush}" />
                    <Setter Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ToolbarRoot">
        <Border BorderThickness="1" CornerRadius="9" Padding="7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ScreenshotToolbarBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ScreenshotToolbarBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                     Value="True">
                            <Setter Property="Background" Value="{x:Static SystemColors.WindowBrush}" />
                            <Setter Property="BorderBrush" Value="{x:Static SystemColors.WindowTextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          Focusable="False">
            <ItemsControl x:Name="ToolbarItems"
                          ItemsSource="{Binding Items}"
                          Margin="0,0,-4,-4"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.DirectionalNavigation="Cycle">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,4,4" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button IsEnabled="{Binding IsEnabled}"
                                IsTabStop="True"
                                Click="OnToolbarClick"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding Label}"
                                AutomationProperties.HelpText="{Binding HelpText}"
                                AutomationProperties.ItemStatus="{Binding AutomationItemStatus}">
                            <Button.Content>
                                <Grid Width="20" Height="20">
                                    <TextBlock x:Name="GlyphText"
                                               Text="{Binding Glyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center" />
                                    <Ellipse x:Name="ColorIndicator"
                                             Width="17" Height="17"
                                             Fill="{Binding CurrentColorBrush}"
                                             Stroke="White" StrokeThickness="1.5"
                                             Visibility="Collapsed" />
                                    <Border x:Name="LineWidthIndicator"
                                            Width="19"
                                            Height="{Binding CurrentLineWidth}"
                                            CornerRadius="5"
                                            Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                            Visibility="Collapsed" />
                                    <TextBlock x:Name="FontSizeIndicator"
                                               Text="{Binding CurrentFontSizeLabel}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Button.Content>
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ScreenshotTooltipStyle}"
                                         Content="{Binding HelpText}" />
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ScreenshotToolbarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStyleIndicator}" Value="True">
                                            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsColorIndicator}" Value="True">
                                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ColorIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLineWidthIndicator}" Value="True">
                                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="LineWidthIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFontSizeIndicator}" Value="True">
                                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="FontSizeIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Border>

        <Popup x:Name="StylePopover"
               AllowsTransparency="True"
               Focusable="False"
               Placement="Top"
               VerticalOffset="-6"
               StaysOpen="True"
               Opened="OnStylePopoverOpened"
               Closed="OnStylePopoverClosed">
            <Border x:Name="StylePopoverBorder"
                    Padding="7"
                    BorderThickness="1"
                    CornerRadius="9"
                    Background="{DynamicResource ScreenshotToolbarBackgroundBrush}"
                    BorderBrush="{DynamicResource ScreenshotToolbarBorderBrush}">
                <ItemsControl x:Name="StyleOptionItems"
                              Margin="0,0,-8,0"
                              KeyboardNavigation.TabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Cycle">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ScreenshotPopoverOptionButton}"
                                    IsTabStop="True"
                                    Click="OnStyleOptionClick"
                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                    AutomationProperties.Name="{Binding Label}"
                                    AutomationProperties.HelpText="{Binding Label}"
                                    AutomationProperties.ItemStatus="{Binding AutomationItemStatus}">
                                <Grid Width="20" Height="20">
                                    <Ellipse x:Name="OptionColorIndicator"
                                             Width="20" Height="20"
                                             Fill="{Binding ColorBrush}"
                                             Stroke="#2E000000" StrokeThickness="1"
                                             Visibility="Collapsed" />
                                    <Ellipse x:Name="SelectedColorRing"
                                             Width="24" Height="24"
                                             Stroke="{DynamicResource ScreenshotAccentBrush}"
                                             StrokeThickness="2"
                                             Visibility="Collapsed" />
                                    <Ellipse x:Name="OptionLineWidthIndicator"
                                             Width="{Binding DotSize}"
                                             Height="{Binding DotSize}"
                                             Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                             Visibility="Collapsed" />
                                    <TextBlock x:Name="OptionFontSizeIndicator"
                                               Text="{Binding ShortLabel}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsColor}" Value="True">
                                    <Setter TargetName="OptionColorIndicator" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowsSelectedColorRing}" Value="True">
                                    <Setter TargetName="SelectedColorRing" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLineWidth}" Value="True">
                                    <Setter TargetName="OptionLineWidthIndicator" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFontSize}" Value="True">
                                    <Setter TargetName="OptionFontSizeIndicator" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</Window>
