<UserControl x:Class="VoxFlow.Windows.App.Home.HomeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             xmlns:home="clr-namespace:VoxFlow.Windows.App.Home"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="HomeQuietButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource VoxFlowButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="HomeModalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="12"
                                      Direction="270"
                                      Opacity="0.18"
                                      Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <UniformGrid Columns="6" Margin="0,0,0,18">
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static l10n:L10n.HomeStatsTotal}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Statistics.TotalAssets}"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="2,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static l10n:L10n.HomeStatsToday}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Statistics.TodayAssets}"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="4,0,2,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static l10n:L10n.HomeStatsCharacters}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Statistics.DictationAssets}"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static l10n:L10n.HomeStatsDuration}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Statistics.ScreenshotAssets}"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static l10n:L10n.HomeStatsClipboard}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Statistics.ClipboardAssets}"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{x:Static l10n:L10n.HomeStatsReusable}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Statistics.ReusableAssets}"
                                       Margin="0,6,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource VoxFlowCardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80A;" FontFamily="Segoe Fluent Icons"
                                               FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static l10n:L10n.HomeActivityTitle}"
                                               Margin="9,0,0,0"
                                               FontSize="{DynamicResource TitleFontSize}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{x:Static l10n:L10n.HomeActivitySubtitle}"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActivityThisWeekLabel}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding ActivityWeekdayLabels}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Height="16"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Viewbox Grid.Column="1"
                                     Stretch="Uniform"
                                     StretchDirection="Both"
                                     HorizontalAlignment="Stretch"
                                     Height="112">
                                <ItemsControl ItemsSource="{Binding ActivityWeeks}"
                                              Width="624" Height="82">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="52" Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type home:HomeActivityWeek}">
                                            <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,2,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type home:HomeActivityDay}">
                                                        <Border Width="10" Height="10" Margin="0,0,0,2"
                                                                CornerRadius="2"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Opacity="{Binding Opacity}"
                                                                ToolTip="{Binding Date}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <TextBlock Text="{x:Static l10n:L10n.HomeActivityLess}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11" />
                            <Border Width="10" Height="10" Margin="7,2,0,0" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.10" />
                            <Border Width="10" Height="10" Margin="4,2,0,0" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.32" />
                            <Border Width="10" Height="10" Margin="4,2,0,0" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.50" />
                            <Border Width="10" Height="10" Margin="4,2,0,0" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.68" />
                            <Border Width="10" Height="10" Margin="4,2,7,0" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.88" />
                            <TextBlock Text="{x:Static l10n:L10n.HomeActivityMore}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource VoxFlowCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons"
                                       FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static l10n:L10n.HistoryTitle}"
                                       Margin="9,0,0,0"
                                       FontSize="{DynamicResource TitleFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HistoryCountLabel}"
                                       Margin="12,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static l10n:L10n.HistorySearchLabel}"
                                           Margin="0,0,0,5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource PanelBorderBrush}"
                                         AutomationProperties.Name="{x:Static l10n:L10n.HistorySearchLabel}"
                                         TabIndex="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static l10n:L10n.HistorySourceLabel}"
                                           Margin="0,0,0,5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding SourceFilterOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SourceFilter, Mode=TwoWay}"
                                          Padding="8,6"
                                          Background="{DynamicResource ControlBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          AutomationProperties.Name="{x:Static l10n:L10n.HistorySourceLabel}"
                                          TabIndex="1" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <TextBlock Text="{x:Static l10n:L10n.HistoryEmpty}"
                                       Padding="0,18"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalFilteredCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding VisibleEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type home:HomeHistoryItem}">
                                        <Border Margin="0,0,0,8"
                                                Padding="14"
                                                CornerRadius="{DynamicResource RowCornerRadius}"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Tag="{Binding Id}"
                                                MouseLeftButtonUp="OnAssetRowClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center"
                                                          ToolTip="{x:Static l10n:L10n.HistorySelect}"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          Tag="{Binding Id}"
                                                          Click="OnSelectionClick"
                                                          AutomationProperties.Name="{x:Static l10n:L10n.HistorySelect}" />
                                                <Border Grid.Column="2"
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="9"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        ToolTip="{Binding SourceLabel}">
                                                    <TextBlock Text="{Binding WorkflowGlyph}"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource AccentDarkBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="44" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding SourceLabel}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="{DynamicResource CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource CaptionFontSize}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ContentTypeLabel}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="{DynamicResource CaptionFontSize}" />
                                                        <TextBlock Text="{Binding MetaPreview}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="{DynamicResource CaptionFontSize}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="360" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,5,0,0"
                                                               Text="{Binding CreatedAtUtc, StringFormat={}{0:g}}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontSize="{DynamicResource CaptionFontSize}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{x:Static l10n:L10n.HistoryCopy}"
                                                            Tag="{Binding Id}"
                                                            Style="{StaticResource HomeQuietButtonStyle}"
                                                            Click="OnCopyClick"
                                                            AutomationProperties.Name="{x:Static l10n:L10n.HistoryCopy}" />
                                                    <Button Content="{x:Static l10n:L10n.HistoryDetails}"
                                                            Tag="{Binding Id}"
                                                            Style="{StaticResource HomeQuietButtonStyle}"
                                                            Click="OnDetailsClick"
                                                            AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetails}" />
                                                    <Button Content="{x:Static l10n:L10n.HistoryDelete}"
                                                            Tag="{Binding Id}"
                                                            Style="{StaticResource HomeQuietButtonStyle}"
                                                            Click="OnDeleteClick"
                                                            AutomationProperties.Name="{x:Static l10n:L10n.HistoryDelete}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static l10n:L10n.HistoryClearAll}"
                                        Style="{StaticResource HomeQuietButtonStyle}"
                                        Margin="0"
                                        IsEnabled="{Binding CanClearAll}"
                                        ToolTip="{Binding ClearAllUnavailableReason}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="OnClearAllClick"
                                        AutomationProperties.Name="{x:Static l10n:L10n.HistoryClearAll}"
                                        AutomationProperties.HelpText="{Binding ClearAllUnavailableReason}" />
                                <Button Content="{x:Static l10n:L10n.HistoryDeleteSelected}"
                                        Style="{StaticResource HomeQuietButtonStyle}"
                                        IsEnabled="{Binding CanDeleteSelected}"
                                        ToolTip="{Binding DeleteSelectedUnavailableReason}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="OnDeleteSelectedClick"
                                        AutomationProperties.Name="{x:Static l10n:L10n.HistoryDeleteSelected}"
                                        AutomationProperties.HelpText="{Binding DeleteSelectedUnavailableReason}" />
                                <Button Content="{x:Static l10n:L10n.HistorySelectAll}"
                                        Style="{StaticResource HomeQuietButtonStyle}"
                                        Click="OnSelectAllClick"
                                        AutomationProperties.Name="{x:Static l10n:L10n.HistorySelectAll}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{x:Static l10n:L10n.HistoryPreviousPage}"
                                        Style="{StaticResource HomeQuietButtonStyle}"
                                        Margin="0"
                                        IsEnabled="{Binding CanGoPrevious}"
                                        Click="OnPreviousPageClick"
                                        AutomationProperties.Name="{x:Static l10n:L10n.HistoryPreviousPage}" />
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding TotalPages, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="{x:Static l10n:L10n.HistoryNextPage}"
                                        Style="{StaticResource HomeQuietButtonStyle}"
                                        Margin="0"
                                        IsEnabled="{Binding CanGoNext}"
                                        Click="OnNextPageClick"
                                        AutomationProperties.Name="{x:Static l10n:L10n.HistoryNextPage}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ActionFeedback}"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Mac-style centered detail modal overlay -->
        <Grid Panel.ZIndex="100"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailTitle}">
            <Border Background="#2E000000"
                    MouseLeftButtonDown="OnDetailBackdropClick" />
            <Border Style="{StaticResource HomeModalCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="760"
                    MaxWidth="920"
                    MaxHeight="760"
                    MinHeight="420"
                    DataContext="{Binding SelectedDetail}"
                    MouseLeftButtonDown="OnDetailCardMouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46"
                                Height="46"
                                CornerRadius="12"
                                Background="{DynamicResource AccentSoftBrush}"
                                ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/VoxFlow.png"
                                   Width="28"
                                   Height="28"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SourceLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="13" />
                                <TextBlock Text=" · "
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="13" />
                                <TextBlock Text="{Binding ContentTypeLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="✕"
                                Width="32"
                                Height="32"
                                Style="{StaticResource HomeQuietButtonStyle}"
                                Margin="0"
                                Click="OnCloseDetailClick"
                                ToolTip="{x:Static l10n:L10n.HistoryDetailClose}"
                                AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailClose}"
                                TabIndex="2" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Screenshot asset detail (Mac HomeAssetDetailModal) -->
                            <StackPanel Visibility="{Binding IsScreenshot, Converter={StaticResource BoolToVisibility}}">
                                <Border MaxHeight="360"
                                        MinHeight="120"
                                        CornerRadius="14"
                                        Background="{DynamicResource PageBackgroundBrush}"
                                        ClipToBounds="True"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Image Source="{Binding DisplayedImage}"
                                               Stretch="Uniform"
                                               MaxHeight="360"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static l10n:L10n.ScreenshotImageUnavailable}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Padding="14"
                                        MinHeight="140"
                                        MaxHeight="260"
                                        CornerRadius="14"
                                        Background="{DynamicResource PageBackgroundBrush}"
                                        Margin="0,0,0,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding PreviewText}"
                                                   TextWrapping="Wrap"
                                                   FontSize="15"
                                                   LineHeight="22">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PreviewText}" Value="">
                                                            <Setter Property="Text" Value="{x:Static l10n:L10n.HistoryNoPreview}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Margin="0,0,0,14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="{x:Static l10n:L10n.ScreenshotResolution}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{x:Static l10n:L10n.ScreenshotFavoriteStatus}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding FavoriteLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Voice / workflow text comparison -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScreenshot}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12"
                                            MinHeight="120"
                                            MaxHeight="200"
                                            CornerRadius="12"
                                            Background="{DynamicResource PageBackgroundBrush}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top"
                                                       Text="{x:Static l10n:L10n.HistoryDetailRawText}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBox Text="{Binding RawText, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailRawText}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Padding="12"
                                            MinHeight="120"
                                            MaxHeight="200"
                                            CornerRadius="12"
                                            Background="{DynamicResource PageBackgroundBrush}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top"
                                                       Text="{x:Static l10n:L10n.HistoryDetailFinalText}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBox Text="{Binding EditedFinalText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailFinalText}"
                                                         TabIndex="4" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14"
                                            Visibility="{Binding IsDictation, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="{x:Static l10n:L10n.HistoryDetailSave}"
                                            Style="{StaticResource VoxFlowButtonStyle}"
                                            IsEnabled="{Binding DataContext.CanSaveSelectedEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.SaveUnavailableReason, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="OnSaveEditClick"
                                            AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailSave}" />
                                    <Button Content="{x:Static l10n:L10n.HistoryDetailReprocess}"
                                            Style="{StaticResource HomeQuietButtonStyle}"
                                            IsEnabled="{Binding DataContext.CanReprocessSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.ReprocessUnavailableReason, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="OnReprocessClick"
                                            AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailReprocess}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsDictation, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailMetadata}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailAsr}" />
                                        <Run Text="{Binding AsrProvider, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailQwen}" />
                                        <Run Text="{Binding QwenVariant, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailLanguage}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding RecognitionLanguage, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailLlm}" />
                                        <Run Text="{Binding LlmProvider, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailDuration}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding DurationMilliseconds, Mode=OneWay}" />
                                        <Run Text=" ms" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailLlmDuration}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding LlmDurationMilliseconds, Mode=OneWay}" />
                                        <Run Text=" ms" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailFrames}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding CapturedFrameCount, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding DroppedFrameCount, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsWorkflow, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailWorkflowMetadata}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailStatus}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailProvider}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding ProviderId, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailModel}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Model, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="{x:Static l10n:L10n.HistoryDetailDuration}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding DurationMilliseconds, Mode=OneWay}" />
                                        <Run Text=" ms" />
                                    </TextBlock>
                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Static l10n:L10n.HistoryDetailFailure}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FailureCode}"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource DestructiveBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailContextSources}"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ContextSources}" Margin="0,5,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailTimeline}"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Events}" Margin="0,5,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailTools}"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ToolNames}" Margin="0,5,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailArtifacts}"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,5,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Static l10n:L10n.HistoryDetailResultSummary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResultSummary}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Text="{x:Static l10n:L10n.HistoryDetailDiagnostic}"
                                           FontWeight="SemiBold" />
                                <TextBox Margin="0,6,0,8"
                                         MinHeight="80"
                                         Padding="10"
                                         Text="{Binding SanitizedDiagnostic, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailDiagnostic}" />
                                <Button Content="{x:Static l10n:L10n.HistoryDetailCopyDiagnostic}"
                                        Style="{StaticResource HomeQuietButtonStyle}"
                                        Margin="0"
                                        HorizontalAlignment="Left"
                                        Click="OnCopyDiagnosticClick"
                                        AutomationProperties.Name="{x:Static l10n:L10n.HistoryDetailCopyDiagnostic}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer actions for screenshot / workflow asset (mac: Copy + Delete) -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScreenshot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorkflow}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="{x:Static l10n:L10n.HistoryCopy}"
                                Style="{StaticResource VoxFlowButtonStyle}"
                                Tag="{Binding Id}"
                                Click="OnDetailCopyClick"
                                AutomationProperties.Name="{x:Static l10n:L10n.HistoryCopy}" />
                        <Button Content="{x:Static l10n:L10n.HistoryDelete}"
                                Style="{StaticResource HomeQuietButtonStyle}"
                                Tag="{Binding Id}"
                                Click="OnDetailDeleteClick"
                                AutomationProperties.Name="{x:Static l10n:L10n.HistoryDelete}" />
                        <TextBlock Text="{Binding DataContext.ActionFeedback, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
