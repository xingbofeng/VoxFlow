<UserControl x:Class="VoxFlow.Windows.App.Glossary.GlossaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
             Loaded="OnLoaded">
    <Grid Margin="{DynamicResource PageSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Heading}"
                           FontSize="{DynamicResource HeadingFontSize}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{x:Static l10n:L10n.GlossaryImport}"
                        Style="{DynamicResource VoxFlowSecondaryButtonStyle}"
                        Click="OnImport" />
                <Button Content="{x:Static l10n:L10n.GlossaryOpenFolder}"
                        Margin="10,0,0,0"
                        Style="{DynamicResource VoxFlowSecondaryButtonStyle}"
                        Click="OnOpenFolder" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource VoxFlowCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="GlossaryTabs"
                                    Width="360"
                                    HorizontalAlignment="Left">
                            <TabItem Header="{x:Static l10n:L10n.GlossaryTabHotwords}" />
                            <TabItem Header="{x:Static l10n:L10n.GlossaryTabReplacements}" />
                        </TabControl>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static l10n:L10n.GlossarySearch}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=GlossaryTabs}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HotwordsView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10"
                                                Padding="12,9"
                                                CornerRadius="16"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Term}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Content="×"
                                                        Tag="{Binding}"
                                                        Margin="8,0,0,0"
                                                        Padding="3,0"
                                                        Style="{DynamicResource VoxFlowQuietButtonStyle}"
                                                        Click="OnDeleteHotword" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=GlossaryTabs}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding ReplacementsView}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,13"
                                            CornerRadius="{DynamicResource RowCornerRadius}"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Target}" />
                                            <Button Grid.Column="3"
                                                    Content="{x:Static l10n:L10n.HistoryDelete}"
                                                    Tag="{Binding}"
                                                    Style="{DynamicResource VoxFlowQuietButtonStyle}"
                                                    Click="OnDeleteReplacement" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="{Binding FeedbackMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Content="{x:Static l10n:L10n.GlossaryAdd}"
                                Click="OnAdd" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource VoxFlowCardStyle}">
                <StackPanel>
                    <TextBlock Text="{x:Static l10n:L10n.GlossarySuggestionsHeading}"
                               FontSize="{DynamicResource TitleFontSize}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static l10n:L10n.GlossarySuggestionsDescription}"
                               Margin="0,7,0,18"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="12"
                                        CornerRadius="{DynamicResource RowCornerRadius}"
                                        Background="{DynamicResource ControlBackgroundBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                        <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                            <Button Content="{x:Static l10n:L10n.GlossarySuggestionAdd}"
                                                    Tag="{Binding}"
                                                    Padding="10,5"
                                                    Click="OnAddSuggestion" />
                                            <Button Content="{x:Static l10n:L10n.GlossarySuggestionIgnore}"
                                                    Tag="{Binding}"
                                                    Margin="7,0,0,0"
                                                    Padding="8,5"
                                                    Style="{DynamicResource VoxFlowQuietButtonStyle}"
                                                    Click="OnIgnoreSuggestion" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
