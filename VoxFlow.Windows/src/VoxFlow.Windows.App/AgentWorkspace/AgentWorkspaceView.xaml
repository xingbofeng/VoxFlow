<UserControl x:Class="VoxFlow.Windows.App.AgentWorkspace.AgentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:VoxFlow.Windows.App.Home"
             Background="{DynamicResource PageBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PageSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{Binding RefreshLabel}"
                    VerticalAlignment="Bottom"
                    Click="OnRefresh" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,18">
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding RuntimeHeading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RuntimeDescription}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource VoxFlowCardStyle}" Margin="8,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" Background="#F7E8FA">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="20"
                                           Foreground="#B42CC7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding HotkeyHeading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HotkeyDescription}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource VoxFlowCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding HistoryHeading}" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding EmptyText}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" Margin="0,28" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type home:HomeHistoryItem}">
                                    <Border Margin="0,0,0,10" Padding="16" CornerRadius="{DynamicResource RowCornerRadius}"
                                            Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding MetaPreview}" Margin="0,6,0,0" MaxHeight="48"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding CreatedAtUtc, StringFormat={}{0:g}}" Margin="0,7,0,0"
                                                           FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding DataContext.CopyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Tag="{Binding Id}" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnCopy" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
