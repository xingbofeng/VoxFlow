<Window x:Class="VoxFlow.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:VoxFlow.Windows.App.Shell"
        xmlns:home="clr-namespace:VoxFlow.Windows.App.Home"
        xmlns:transcription="clr-namespace:VoxFlow.Windows.App.FileTranscription"
        xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings"
        xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
        mc:Ignorable="d"
        Title="{x:Static l10n:L10n.WindowTitle}"
        Width="1260"
        Height="720"
        MinWidth="1260"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            CornerRadius="9"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="V"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{x:Static l10n:L10n.BrandName}"
                               Margin="8,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Content="≡"
                            AutomationProperties.Name="{x:Static l10n:L10n.SidebarToggleAccessibleName}"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnToggleSidebar" />
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedValue="{Binding CurrentRoute, Mode=TwoWay}"
                         SelectedValuePath="Route"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="SelectionBorder"
                                                Padding="10,9"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource ControlBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource PanelBackgroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavigationItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           Margin="10,0,0,0"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type shell:HomePageViewModel}">
                    <Grid Margin="{DynamicResource PageSpacing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding Heading}"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource BodyFontSize}" />
                        </StackPanel>
                        <home:HomeDashboardView Grid.Row="2"
                                                DataContext="{Binding Dashboard}" />
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:SettingsPageViewModel}">
                    <settings:SettingsShellView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type transcription:FileTranscriptionPageViewModel}">
                    <transcription:FileTranscriptionView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
