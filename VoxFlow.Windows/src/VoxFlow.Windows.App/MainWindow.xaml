<Window x:Class="VoxFlow.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:VoxFlow.Windows.App.Shell"
        xmlns:home="clr-namespace:VoxFlow.Windows.App.Home"
        xmlns:agentWorkspace="clr-namespace:VoxFlow.Windows.App.AgentWorkspace"
        xmlns:notes="clr-namespace:VoxFlow.Windows.App.Notes"
        xmlns:help="clr-namespace:VoxFlow.Windows.App.Help"
        xmlns:glossary="clr-namespace:VoxFlow.Windows.App.Glossary"
        xmlns:writingStyles="clr-namespace:VoxFlow.Windows.App.WritingStyles"
        xmlns:transcription="clr-namespace:VoxFlow.Windows.App.FileTranscription"
        xmlns:screenshot="clr-namespace:VoxFlow.Windows.App.Screenshot"
        xmlns:settings="clr-namespace:VoxFlow.Windows.App.Settings"
        xmlns:l10n="clr-namespace:VoxFlow.Windows.App.Localization"
        mc:Ignorable="d"
        Title="{x:Static l10n:L10n.WindowTitle}"
        Icon="Assets/VoxFlow.png"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32"
                           Height="32"
                           Source="Assets/VoxFlow.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Static l10n:L10n.BrandName}"
                               Margin="8,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Content="≡"
                            AutomationProperties.Name="{x:Static l10n:L10n.SidebarToggleAccessibleName}"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnToggleSidebar" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <ListBox x:Name="PrimaryNavigation"
                         Grid.Row="0"
                         ItemsSource="{Binding PrimaryNavigationItems}"
                         SelectedValue="{Binding CurrentRoute, Mode=OneWay}"
                         SelectedValuePath="Route"
                         SelectionChanged="OnNavigationSelectionChanged"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Border x:Name="SelectionBorder"
                                                    Padding="10,10"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                            <Border x:Name="SelectionIndicator"
                                                    Width="3"
                                                    Height="22"
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavigationItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           Margin="10,0,0,0"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FooterNavigationItems}"
                             SelectedValue="{Binding CurrentRoute, Mode=OneWay}"
                             SelectedValuePath="Route"
                             SelectionChanged="OnNavigationSelectionChanged"
                             Background="Transparent"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{Binding ItemContainerStyle, ElementName=PrimaryNavigation}"
                             ItemTemplate="{Binding ItemTemplate, ElementName=PrimaryNavigation}" />
                </Grid>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type shell:HomePageViewModel}">
                    <Grid Margin="{DynamicResource PageSpacing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="30"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Heading}"
                                       Margin="12,0,0,0"
                                       FontSize="{DynamicResource HeadingFontSize}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <home:HomeDashboardView Grid.Row="2"
                                                DataContext="{Binding Dashboard}" />
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:SettingsPageViewModel}">
                    <settings:SettingsShellView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:AgentWorkspacePageViewModel}">
                    <agentWorkspace:AgentWorkspaceView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:GlossaryPageViewModel}">
                    <glossary:GlossaryView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:WritingStylesPageViewModel}">
                    <writingStyles:WritingStylesView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:NotesPageViewModel}">
                    <notes:NotesView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type shell:HelpPageViewModel}">
                    <help:HelpView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type transcription:FileTranscriptionPageViewModel}">
                    <transcription:FileTranscriptionView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type screenshot:ScreenshotMediaPageViewModel}">
                    <screenshot:ScreenshotMediaView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
