# This file is a safe template. Copy it to .env.live and fill values only on your local machine.
# Keep live tests disabled unless you intentionally run a manual integration check.
VOXFLOW_LIVE_ENABLED=0

# OpenAI official API: used only by manually triggered local live tests.
VOXFLOW_LIVE_OPENAI_API_KEY=
VOXFLOW_LIVE_OPENAI_MODEL=gpt-4.1-mini

# Generic OpenAI-compatible endpoint smoke. Values stay local and are never
# product defaults; provide a short, non-personal prompt explicitly.
VOXFLOW_LIVE_OPENAI_COMPAT_BASE_URL=
VOXFLOW_LIVE_OPENAI_COMPAT_MODEL=
VOXFLOW_LIVE_OPENAI_COMPAT_PROMPT=

# Tencent Cloud streaming ASR.
VOXFLOW_LIVE_TENCENT_ASR_APP_ID=
VOXFLOW_LIVE_TENCENT_ASR_SECRET_ID=
VOXFLOW_LIVE_TENCENT_ASR_SECRET_KEY=
VOXFLOW_LIVE_TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh

# Alibaba Cloud streaming ASR.
VOXFLOW_LIVE_ALIYUN_ASR_API_KEY=

# Volcengine streaming ASR.
VOXFLOW_LIVE_VOLCENGINE_ASR_APP_ID=
VOXFLOW_LIVE_VOLCENGINE_ASR_ACCESS_TOKEN=
VOXFLOW_LIVE_VOLCENGINE_ASR_SECRET_KEY=
