+/* Modified Bessel function, first kind, order zero. The power series
+ * converges quickly for the resampler's beta <= 10. Kept as a C11 function
+ * because MSVC does not support GCC statement expressions. */
+static double qwen_bessel_i0(double x) {
+    double sum = 1.0, term = 1.0, xx = x * x;
+    for (int k = 1; k <= 20; k++) {
+        term *= xx / (4.0 * (double)k * (double)k);
+        sum += term;
+    }
+    return sum;
+}
